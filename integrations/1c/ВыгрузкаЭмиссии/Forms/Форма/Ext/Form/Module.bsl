&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Режим = "local";
    Префикс = "Задания/";
    НачалоПериода = НачалоДня(ТекущаяДатаСеанса() - 30 * 86400);
    КонецПериода = КонецДня(ТекущаяДатаСеанса());
    Элементы.Режим.РежимВыбораИзСписка = Истина;
    Элементы.Режим.СписокВыбора.Добавить("local", "Локальная папка 1CExchange");
    Элементы.Режим.СписокВыбора.Добавить("aws", "Хранилище через AWS CLI");
    Элементы.Режим.СписокВыбора.Добавить("function", "Хранилище через облачную функцию");
    Попытка
        Сохраненные = ХранилищеОбщихНастроек.Загрузить("xTrek.DirectEmission.v2", "Transport");
        Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
            ЗаполнитьЗначенияСвойств(ЭтотОбъект, Сохраненные,
                "Режим,Папка,Бакет,Префикс,ПрофильAWS,АдресФункции,ПапкаЖурнала");
        КонецЕсли;
    Исключение
        Результат = "Не удалось прочитать персональные настройки: " + ОписаниеОшибки();
    КонецПопытки;
    НастроитьПоля();
    ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Функция НастройкиТранспорта()
    Возврат Новый Структура("Режим,Папка,Бакет,Префикс,ПрофильAWS,АдресФункции,ПапкаЖурнала",
        Режим, Папка, Бакет, Префикс, ПрофильAWS, АдресФункции, ПапкаЖурнала);
КонецФункции

&НаСервере
Процедура НастроитьПоля()
    Элементы.Папка.Видимость = Режим = "local";
    Элементы.Бакет.Видимость = Режим = "aws";
    Элементы.ПрофильAWS.Видимость = Режим = "aws";
    Элементы.Префикс.Видимость = Режим <> "local";
    Элементы.АдресФункции.Видимость = Режим = "function";
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()
    ДатыПодтверждены = Ложь;
    Если НачалоПериода > КонецПериода Тогда ВызватьИсключение "Начало периода позже окончания."; КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 201
    | Док.Ссылка КАК Документ, Док.Дата КАК Дата,
    | Док.ИдентификаторЗаказа КАК OrderId,
    | ВЫРАЗИТЬ(Док.Основание КАК Документ.ЗаказНаПроизводство).ПроизводственнаяСерия.ПланируемаяДатаПроизводства КАК ПроизводствоСерии,
    | ВЫРАЗИТЬ(Док.Основание КАК Документ.ЗаказНаПроизводство).ПроизводственнаяСерия.СрокОкончанияГодности КАК ГодностьСерии
    |ИЗ Документ.ЗаказНаЭмиссиюКодовМаркировкиСУЗ КАК Док
    |ГДЕ Док.Дата МЕЖДУ &Начало И &Конец И НЕ Док.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО Док.Дата УБЫВ, Док.Ссылка";
    Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
    Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
    Выборка = Запрос.Выполнить().Выбрать();
    Эмиссии.Очистить();
    Пока Выборка.Следующий() Цикл
        Если Эмиссии.Количество() = 200 Тогда
            Результат = "Показаны 200 последних эмиссий. Для остальных сузьте период.";
            Прервать;
        КонецЕсли;
        СтрокаСписка = Эмиссии.Добавить();
        ЗаполнитьЗначенияСвойств(СтрокаСписка, Выборка, "Документ,Дата,OrderId");
        Если ТипЗнч(Выборка.ПроизводствоСерии) = Тип("Дата") И ЗначениеЗаполнено(Выборка.ПроизводствоСерии) Тогда
            СтрокаСписка.ДатаПроизводства = Формат(Выборка.ПроизводствоСерии, "ДФ=yyyy-MM-dd");
        Иначе
            СтрокаСписка.ДатаПроизводства = "Не задана";
        КонецЕсли;
        Если ТипЗнч(Выборка.ГодностьСерии) = Тип("Дата") И ЗначениеЗаполнено(Выборка.ГодностьСерии) Тогда
            СтрокаСписка.ГоденДо = Формат(Выборка.ГодностьСерии, "ДФ=yyyy-MM-dd");
        Иначе
            СтрокаСписка.ГоденДо = "Не задана";
        КонецЕсли;
    КонецЦикла;
    ЗаполнитьТоварныеДанные();
    ОбновитьОтметки();
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтметки()
    Обработка = РеквизитФормыВЗначение("Объект");
    Настройки = НастройкиТранспорта();
    ОшибкаЖурнала = "";
    Попытка
        Обработка.ПроверитьПапкуЖурнала(ПапкаЖурнала);
    Исключение
        ОшибкаЖурнала = ОписаниеОшибки();
    КонецПопытки;
    Для Каждого СтрокаСписка Из Эмиссии Цикл
        СтрокаСписка.Состояние = "Статус неизвестен";
        Если Не ПустаяСтрока(ОшибкаЖурнала) Тогда Продолжить; КонецЕсли;
        Попытка
            Отметка = Обработка.ПрочитатьОтметку(ПапкаЖурнала,
                Строка(СтрокаСписка.Документ.УникальныйИдентификатор()), Настройки);
            Если Отметка = Неопределено Тогда
                СтрокаСписка.Состояние = "Нет отметки выгрузки";
            Иначе
                СтрокаСписка.Состояние = "Выгружено " + Отметка.exportedAt;
            КонецЕсли;
        Исключение
            СтрокаСписка.Проверка = ОписаниеОшибки();
        КонецПопытки;
    КонецЦикла;
    Если Не ПустаяСтрока(ОшибкаЖурнала) Тогда Результат = ОшибкаЖурнала; КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере(ТолькоПроверка)
    Если Не ТолькоПроверка И Не ДатыПодтверждены Тогда
        ВызватьИсключение "Проверьте выделенные строки и подтвердите их даты.";
    КонецЕсли;
    Если ТолькоПроверка Тогда ДатыПодтверждены = Ложь; КонецЕсли;
    Обработка = РеквизитФормыВЗначение("Объект");
    Настройки = НастройкиТранспорта();
    Если Не ТолькоПроверка Тогда
        Обработка.ПроверитьПапкуЖурнала(ПапкаЖурнала);
        // До первой публикации убедиться, что каждая выбранная строка проверялась.
        Для Каждого СтрокаСписка Из Эмиссии Цикл
            Если СтрокаСписка.Выбрано И ПустаяСтрока(СтрокаСписка.Отпечаток) Тогда
                ВызватьИсключение "Среди выбранных есть непроверенные строки. Повторите проверку.";
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Успешно = 0;
    Ошибок = 0;
    Для Каждого СтрокаСписка Из Эмиссии Цикл
        Если Не СтрокаСписка.Выбрано Тогда Продолжить; КонецЕсли;
        ПараВыгружена = Ложь;
        Попытка
            Пакет = Обработка.Подготовить(СтрокаСписка.Документ);
            Отпечаток = Обработка.ОтпечатокПакета(Пакет, Настройки);
            ЗаполнитьЗначенияСвойств(СтрокаСписка, Пакет, "OrderId,Количество,ДатаПроизводства,ГоденДо");
            Если ТолькоПроверка Тогда
                СтрокаСписка.Отпечаток = Отпечаток;
                СтрокаСписка.Проверка = "Проверено; подтвердите даты";
            Иначе
                Если СтрокаСписка.Отпечаток <> Отпечаток Тогда
                    ВызватьИсключение "Данные или назначение изменились. Нужна повторная проверка и подтверждение дат.";
                КонецЕсли;
                Предыдущая = Обработка.ПрочитатьОтметку(ПапкаЖурнала, Пакет.TaskId, Настройки);
                Если Предыдущая <> Неопределено И Предыдущая.fingerprint <> Отпечаток Тогда
                    ВызватьИсключение "Содержимое изменилось после прошлой выгрузки. Перезапись запрещена.";
                КонецЕсли;
                Обработка.Выгрузить(Пакет, Настройки);
                ПараВыгружена = Истина;
                Обработка.ЗаписатьОтметку(ПапкаЖурнала, Пакет, Настройки);
                Отметка = Обработка.ПрочитатьОтметку(ПапкаЖурнала, Пакет.TaskId, Настройки);
                СтрокаСписка.Состояние = "Выгружено " + Отметка.exportedAt;
                СтрокаСписка.Проверка = "Оба файла выгружены";
                СтрокаСписка.Выбрано = Ложь;
            КонецЕсли;
            Успешно = Успешно + 1;
        Исключение
            СтрокаСписка.Отпечаток = "";
            СтрокаСписка.Проверка = ОписаниеОшибки();
            Если ПараВыгружена Тогда
                СтрокаСписка.Состояние = "Файлы выгружены; отметка не сохранена";
            ИначеЕсли Не ТолькоПроверка Тогда
                СтрокаСписка.Состояние = "Ошибка; возможна частичная выгрузка";
            КонецЕсли;
            Ошибок = Ошибок + 1;
        КонецПопытки;
    КонецЦикла;
    ДатыПодтверждены = Ложь;
    Результат = СтрШаблон("Обработано успешно: %1; ошибок: %2. Подробности в строках списка.", Успешно, Ошибок);
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()
    ХранилищеОбщихНастроек.Сохранить("xTrek.DirectEmission.v2", "Transport", НастройкиТранспорта());
    Результат = "Настройки сохранены для текущего пользователя. Папка отметок должна быть общей для всех пользователей.";
КонецПроцедуры

&НаСервере
Процедура СброситьПроверку()
    ДатыПодтверждены = Ложь;
    Для Каждого СтрокаСписка Из Эмиссии Цикл
        СтрокаСписка.Отпечаток = "";
        СтрокаСписка.Проверка = "";
    КонецЦикла;
    НастроитьПоля();
    ОбновитьОтметки();
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
    ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)
    ВыполнитьНаСервере(Истина);
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
    Если Режим <> "aws" Тогда
        ВыполнитьНаСервере(Ложь);
        Возврат;
    КонецЕсли;
    ДокументыКВыгрузке = ПроверитьНачалоAWS();
    Успешно = 0;
    Ошибок = 0;
    Для Каждого Документ Из ДокументыКВыгрузке Цикл
        ПараВыгружена = Ложь;
        Попытка
            ДанныеВыгрузки = ПодготовитьAWSНаСервере(Документ);
            Пакет = ДанныеВыгрузки.Пакет;
            Настройки = ДанныеВыгрузки.Настройки;
            СохранитьТекстAWS(Пакет.OrderId + ".json", Пакет.Коды, Настройки);
            СохранитьТекстAWS(Пакет.TaskId + ".json", Пакет.Задание, Настройки);
            ПараВыгружена = Истина;
            ЗавершитьAWSНаСервере(Документ, ДанныеВыгрузки.Отпечаток);
            Успешно = Успешно + 1;
        Исключение
            ОшибкаAWSНаСервере(Документ, ОписаниеОшибки(), ПараВыгружена);
            Ошибок = Ошибок + 1;
        КонецПопытки;
    КонецЦикла;
    ДатыПодтверждены = Ложь;
    Результат = СтрШаблон("Обработано успешно: %1; ошибок: %2. AWS выполнен на клиенте.", Успешно, Ошибок);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
    СохранитьНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РежимПриИзменении(Элемент)
    СброситьПроверку();
КонецПроцедуры

&НаКлиенте
Процедура НастройкиПриИзменении(Элемент)
    СброситьПроверку();
КонецПроцедуры

&НаКлиенте
Процедура ВыборПриИзменении(Элемент)
    ДатыПодтверждены = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьНевыгруженные(Команда)
    ДатыПодтверждены = Ложь;
    Для Каждого СтрокаСписка Из Эмиссии Цикл
        СтрокаСписка.Выбрано = СтрокаСписка.Состояние = "Нет отметки выгрузки";
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделение(Команда)
    ДатыПодтверждены = Ложь;
    Для Каждого СтрокаСписка Из Эмиссии Цикл
        СтрокаСписка.Выбрано = Ложь;
    КонецЦикла;
КонецПроцедуры

// Только реквизиты товарных строк выбранных документов, без вложений с кодами.
&НаСервере
Процедура ЗаполнитьТоварныеДанные()
    Ссылки = Новый Массив;
    СтрокиПоДокументам = Новый Соответствие;
    КоличестваСтрок = Новый Соответствие;
    Для Каждого СтрокаСписка Из Эмиссии Цикл
        Ссылки.Добавить(СтрокаСписка.Документ);
        СтрокиПоДокументам.Вставить(СтрокаСписка.Документ, СтрокаСписка);
        КоличестваСтрок.Вставить(СтрокаСписка.Документ, 0);
    КонецЦикла;
    Если Ссылки.Количество() = 0 Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Документ, Т.GTIN КАК GTIN,
    | Т.Номенклатура КАК Номенклатура,
    | Т.Номенклатура.Артикул КАК Артикул,
    | Т.Номенклатура.Наименование КАК Наименование
    |ИЗ Документ.ЗаказНаЭмиссиюКодовМаркировкиСУЗ.Товары КАК Т
    |ГДЕ Т.Ссылка В (&Ссылки)");
    Запрос.УстановитьПараметр("Ссылки", Ссылки);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        СтрокаСписка = СтрокиПоДокументам.Получить(Выборка.Документ);
        КоличествоСтрок = КоличестваСтрок.Получить(Выборка.Документ) + 1;
        КоличестваСтрок.Вставить(Выборка.Документ, КоличествоСтрок);
        Если КоличествоСтрок = 1 Тогда
            ЗаполнитьЗначенияСвойств(СтрокаСписка, Выборка, "GTIN,Номенклатура,Артикул,Наименование");
        Иначе
            СтрокаСписка.GTIN = "";
            СтрокаСписка.Артикул = "";
            СтрокаСписка.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
            СтрокаСписка.Наименование = "Несколько товарных строк — выгрузка не поддерживается";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЭмиссию(Команда)
    СтрокаСписка = Элементы.Эмиссии.ТекущиеДанные;
    Если СтрокаСписка <> Неопределено Тогда
        ПоказатьЗначение(, СтрокаСписка.Документ);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЭмиссииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
    Если Поле = Неопределено Тогда Возврат; КонецЕсли;
    Если Поле.Имя = "ЭмиссииДокумент" Тогда
        СтандартнаяОбработка = Ложь;
        ОткрытьЭмиссию(Неопределено);
    ИначеЕсли Поле.Имя = "ЭмиссииНоменклатура" Тогда
        СтрокаСписка = Элементы.Эмиссии.ТекущиеДанные;
        Если СтрокаСписка <> Неопределено И ЗначениеЗаполнено(СтрокаСписка.Номенклатура) Тогда
            СтандартнаяОбработка = Ложь;
            ПоказатьЗначение(, СтрокаСписка.Номенклатура);
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьНачалоAWS()
    Если Режим <> "aws" Или Не ДатыПодтверждены Тогда
        ВызватьИсключение "Проверьте выделенные строки и подтвердите даты.";
    КонецЕсли;
    Обработка = РеквизитФормыВЗначение("Объект");
    Обработка.ПроверитьПапкуЖурнала(ПапкаЖурнала);
    Список = Новый Массив;
    Для Каждого СтрокаСписка Из Эмиссии Цикл
        Если Не СтрокаСписка.Выбрано Тогда Продолжить; КонецЕсли;
        Если ПустаяСтрока(СтрокаСписка.Отпечаток) Тогда
            ВызватьИсключение "Повторите проверку выделенных строк.";
        КонецЕсли;
        Список.Добавить(СтрокаСписка.Документ);
    КонецЦикла;
    Возврат Список;
КонецФункции

&НаСервере
Функция ПодготовитьAWSНаСервере(Документ)
    Если Режим <> "aws" Или Не ДатыПодтверждены Тогда ВызватьИсключение "Нет подтверждения выгрузки AWS."; КонецЕсли;
    Для Каждого СтрокаСписка Из Эмиссии Цикл
        Если СтрокаСписка.Документ <> Документ Или Не СтрокаСписка.Выбрано Тогда Продолжить; КонецЕсли;
        Обработка = РеквизитФормыВЗначение("Объект");
        Настройки = НастройкиТранспорта();
        Пакет = Обработка.Подготовить(Документ);
        Отпечаток = Обработка.ОтпечатокПакета(Пакет, Настройки);
        Если СтрокаСписка.Отпечаток <> Отпечаток Тогда
            ВызватьИсключение "Данные или назначение изменились. Повторите проверку и подтверждение дат.";
        КонецЕсли;
        Предыдущая = Обработка.ПрочитатьОтметку(ПапкаЖурнала, Пакет.TaskId, Настройки);
        Если Предыдущая <> Неопределено И Предыдущая.fingerprint <> Отпечаток Тогда
            ВызватьИсключение "Содержимое изменилось после прошлой выгрузки. Перезапись запрещена.";
        КонецЕсли;
        Возврат Новый Структура("Пакет,Настройки,Отпечаток", Пакет, Настройки, Отпечаток);
    КонецЦикла;
    ВызватьИсключение "Документ отсутствует среди выделенных строк.";
КонецФункции

&НаСервере
Процедура ЗавершитьAWSНаСервере(Документ, Отпечаток)
    ДанныеВыгрузки = ПодготовитьAWSНаСервере(Документ);
    Если ДанныеВыгрузки.Отпечаток <> Отпечаток Тогда
        ВызватьИсключение "После выгрузки данные изменились; отметка не сохранена.";
    КонецЕсли;
    Обработка = РеквизитФормыВЗначение("Объект");
    Обработка.ЗаписатьОтметку(ПапкаЖурнала, ДанныеВыгрузки.Пакет, ДанныеВыгрузки.Настройки);
    Отметка = Обработка.ПрочитатьОтметку(ПапкаЖурнала, ДанныеВыгрузки.Пакет.TaskId, ДанныеВыгрузки.Настройки);
    Для Каждого СтрокаСписка Из Эмиссии Цикл
        Если СтрокаСписка.Документ = Документ Тогда
            СтрокаСписка.Состояние = "Выгружено " + Отметка.exportedAt;
            СтрокаСписка.Проверка = "Оба файла выгружены с клиента";
            СтрокаСписка.Выбрано = Ложь;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОшибкаAWSНаСервере(Документ, ТекстОшибки, ПараВыгружена)
    Для Каждого СтрокаСписка Из Эмиссии Цикл
        Если СтрокаСписка.Документ = Документ Тогда
            СтрокаСписка.Отпечаток = "";
            СтрокаСписка.Проверка = ТекстОшибки;
            СтрокаСписка.Состояние = ?(ПараВыгружена, "Файлы выгружены; отметка не сохранена", "Ошибка; возможна частичная выгрузка");
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция СовпадаютДанныеAWS(Первые, Вторые)
    Если Первые.Размер() <> Вторые.Размер() Тогда Возврат Ложь; КонецЕсли;
    // Точное сравнение байтов через Base64 доступно в тонком клиенте.
    // ХешированиеДанных здесь недоступно; пересылка файлов на сервер не требуется.
    Возврат Base64Строка(Первые) = Base64Строка(Вторые);
КонецФункции

&НаКлиенте
Процедура СохранитьТекстAWS(Имя, Текст, Настройки)
    Данные = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);
    Если Данные.Размер() > 30000000 Тогда ВызватьИсключение "Файл превышает 30 МБ."; КонецЕсли;
    СохранитьAWS(Имя, Данные, Настройки);
КонецПроцедуры
&НаКлиенте
Функция Аргумент(Значение)
    Текст = Строка(Значение);
    Если СтрНайти(Текст, """") > 0 Или СтрНайти(Текст, Символы.ПС) > 0 Или СтрНайти(Текст, Символы.ВК) > 0 Тогда
        ВызватьИсключение "Недопустимый символ в параметре AWS CLI.";
    КонецЕсли;
    Возврат """" + Текст + """";
КонецФункции

&НаКлиенте
Функция ВыполнитьAWS(Аргументы)
    // Run: 0 — скрытое окно, Истина — дождаться завершения и вернуть код AWS.
    // Прямой запуск без cmd.exe сохраняет передачу аргументов AWS CLI.
    Попытка
        Оболочка = Новый COMОбъект("WScript.Shell");
    Исключение
        ВызватьИсключение "Не удалось создать WScript.Shell для скрытого запуска AWS. "
            + "Разрешите использование COM-объекта в обработке. " + ОписаниеОшибки();
    КонецПопытки;
    Возврат Оболочка.Run("aws.exe " + Аргументы + " --no-cli-pager", 0, Истина);
КонецФункции

&НаКлиенте
Процедура СохранитьAWS(Имя, Данные, Настройки)
    Если ПустаяСтрока(Настройки.Бакет) Или ПустаяСтрока(Настройки.Префикс) Или ПустаяСтрока(Настройки.ПрофильAWS) Тогда
        ВызватьИсключение "Для AWS задайте бакет, общую папку и профиль CLI пользователя клиента 1С.";
    КонецЕсли;
    Ключ = Настройки.Префикс + ?(Прав(Настройки.Префикс, 1) = "/", "", "/") + Имя;
    Общие = " --endpoint-url https://storage.yandexcloud.net --profile " + Аргумент(Настройки.ПрофильAWS)
        + " --bucket " + Аргумент(Настройки.Бакет) + " --key " + Аргумент(Ключ);
    Временный = ПолучитьИмяВременногоФайла("json");
    Существующий = ПолучитьИмяВременногоФайла("json");
    Данные.Записать(Временный);
    Попытка
        Прочитано = ВыполнитьAWS("s3api get-object" + Общие + " " + Аргумент(Существующий)) = 0;
        Если Не Прочитано Тогда
            Записано = ВыполнитьAWS("s3api put-object" + Общие + " --if-none-match ""*"" --body " + Аргумент(Временный)) = 0;
            Если Не Записано Тогда
                // Потерянный ответ / конкурентная запись: проверить тело, не перезаписывать.
                Прочитано = ВыполнитьAWS("s3api get-object" + Общие + " " + Аргумент(Существующий)) = 0;
                Если Не Прочитано Тогда ВызватьИсключение "AWS: загрузка не подтверждена."; КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        Если Прочитано И Не СовпадаютДанныеAWS(Новый ДвоичныеДанные(Существующий), Данные) Тогда
            ВызватьИсключение "AWS: под этим именем уже существует другое содержимое.";
        КонецЕсли;
    Исключение
        УдалитьФайлы(Временный);
        УдалитьФайлы(Существующий);
        ВызватьИсключение;
    КонецПопытки;
    УдалитьФайлы(Временный);
    УдалитьФайлы(Существующий);
КонецПроцедуры


&НаКлиенте
Процедура ПроверитьТестовыйAWS(Команда)
    ПутьЖурнала = КаталогВременныхФайлов() + "xtrek-aws-client-ui-v7.txt";
    Попытка
        Настройки = Новый Структура("Бакет,Префикс,ПрофильAWS", "cloud-ediagg-test",
            "direct-mode-synthetic-20261016-aacd4c1b5b/real-unit-set-20261016/.preflight/", "xtrek-direct-test");
        Имя = "client-" + Строка(Новый УникальныйИдентификатор) + ".txt";
        СохранитьТекстAWS(Имя, "XTREK CLIENT TRANSPORT CHECK ONLY", Настройки);
        СохранитьТекстAWS(Имя, "XTREK CLIENT TRANSPORT CHECK ONLY", Настройки);
        Конфликт = Ложь;
        Попытка
            СохранитьТекстAWS(Имя, "DIFFERENT CONTENT MUST NOT OVERWRITE", Настройки);
        Исключение
            Конфликт = СтрНайти(ОписаниеОшибки(), "AWS: под этим именем уже существует другое содержимое.") > 0;
        КонецПопытки;
        Если Не Конфликт Тогда ВызватьИсключение "Не сработала защита от перезаписи."; КонецЕсли;
        Результат = "AWS CLIENT PASS: запись, чтение, повтор и конфликт проверены. Файл: " + Имя;
    Исключение
        Результат = "AWS CLIENT ERROR: " + ОписаниеОшибки();
    КонецПопытки;
    Журнал = Новый ТекстовыйДокумент;
    Журнал.УстановитьТекст(Результат);
    Журнал.Записать(ПутьЖурнала, КодировкаТекста.UTF8);
    Сообщить(Результат);
КонецПроцедуры
