// Внешняя обработка: только чтение документов 1С и выгрузка двух файлов.
// Отправку в СУЗ / ГИС МТ выполняет стандартный маршрут xTrek.
Функция Подготовить(ДокументЭмиссии) Экспорт
    Если Не ЗначениеЗаполнено(ДокументЭмиссии) Тогда
        ВызватьИсключение "Выберите документ эмиссии.";
    КонецЕсли;
    Док = ДокументЭмиссии.ПолучитьОбъект();
    Если Док.ПометкаУдаления Тогда ВызватьИсключение "Документ помечен на удаление."; КонецЕсли;
    OrderId = НРег(Строка(Новый УникальныйИдентификатор(СокрЛП(Док.ИдентификаторЗаказа))));
    Если Док.Товары.Количество() <> 1 Тогда
        ВызватьИсключение "Поддерживается один GTIN в одном документе эмиссии.";
    КонецЕсли;
    Количество = Док.Товары.Итог("КоличествоУпаковок");
    Если Количество <> Док.Товары.Итог("КоличествоПолучено") Или Количество < 1 Или Количество > 30000 Тогда
        ВызватьИсключение "Необходим полный заказ от 1 до 30000 полученных кодов. Разбиение пока не поддерживается.";
    КонецЕсли;
    Если ТипЗнч(Док.Основание) <> Тип("ДокументСсылка.ЗаказНаПроизводство") Тогда
        ВызватьИсключение "Основание эмиссии должно быть заказом на производство.";
    КонецЕсли;
    Основание = Док.Основание;
    Серия = Основание.ПроизводственнаяСерия;
    ДатаПроизводства = Серия.ПланируемаяДатаПроизводства;
    ГоденДо = Серия.СрокОкончанияГодности;
    Если Не ЗначениеЗаполнено(ДатаПроизводства) Или Не ЗначениеЗаполнено(ГоденДо)
        Или НачалоДня(ДатаПроизводства) > НачалоДня(ТекущаяДатаСеанса())
        Или НачалоДня(ГоденДо) <= НачалоДня(ДатаПроизводства)
        Или НачалоДня(ГоденДо) < НачалоДня(ТекущаяДатаСеанса()) Тогда
        ВызватьИсключение "Проверьте даты производственной серии. Дата документа эмиссии вместо них не используется.";
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ Ф.Ссылка КАК Ссылка, Ф.Наименование КАК Имя, Ф.Часть КАК Часть
    |ИЗ Справочник.СУЗПрисоединенныеФайлы КАК Ф
    |ГДЕ Ф.ВладелецФайла = &Документ И НЕ Ф.ПометкаУдаления
    |И Ф.СтатусОбработки = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиСообщенийГИСМ.Принято)
    |И Ф.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыСообщенийГИСМ.Входящее)
    |И Ф.Операция = ЗНАЧЕНИЕ(Перечисление.ОперацииОбменаСУЗ.ПолучениеКодовМаркировки)");
    Запрос.УстановитьПараметр("Документ", ДокументЭмиссии);
    Файлы = Запрос.Выполнить().Выгрузить();
    Если Файлы.Количество() <> 1 Тогда
        ВызватьИсключение "Требуется ровно один принятый блок кодов. Несколько вложений или частей не объединяются.";
    КонецЕсли;
    Данные = РазобратьJSON(ПолучитьСтрокуИзДвоичныхДанных(РаботаСФайлами.ДвоичныеДанныеФайла(Файлы[0].Ссылка)));
    Если Не Данные.Свойство("codes") Тогда ВызватьИсключение "Во вложении отсутствует codes."; КонецЕсли;
    Если ТипЗнч(Данные.codes) <> Тип("Массив") Тогда ВызватьИсключение "codes должен быть массивом."; КонецЕсли;
    Если Данные.codes.Количество() <> Количество Тогда
        ВызватьИсключение "Размер блока не равен полному количеству кодов заказа.";
    КонецЕсли;
    Если Данные.Свойство("blocks") Тогда ВызватьИсключение "Несколько блоков не поддерживаются."; КонецЕсли;
    Если Данные.Свойство("orderId") И ЗначениеЗаполнено(Данные.orderId) Тогда
        Если НРег(Данные.orderId) <> OrderId Тогда ВызватьИсключение "orderId вложения не совпадает с документом."; КонецЕсли;
    КонецЕсли;
    GTIN = СокрЛП(Док.Товары[0].GTIN);
    Если СтрДлина(GTIN) <> 14 Тогда ВызватьИсключение "В документе должен быть GTIN длиной 14 цифр."; КонецЕсли;
    Уникальные = Новый Соответствие;
    Для Каждого Код Из Данные.codes Цикл
        Если ТипЗнч(Код) <> Тип("Строка") Тогда ВызватьИсключение "Некорректный тип кода."; КонецЕсли;
        Разделитель = СтрНайти(Код, Символ(29) + "93");
        Если Лев(Код, 2) <> "01" Или Сред(Код, 17, 2) <> "21" Или Сред(Код, 3, 14) <> GTIN
            Или Разделитель <= 19 Или СтрДлина(Код) <= Разделитель + 2 Тогда
            ВызватьИсключение "Ожидаются полные коды химии одного GTIN с разделителем GS перед 93.";
        КонецЕсли;
        Короткий = Лев(Код, Разделитель - 1);
        Если Уникальные.Получить(Короткий) <> Неопределено Тогда ВызватьИсключение "В блоке обнаружены повторные коды."; КонецЕсли;
        Уникальные.Вставить(Короткий, Истина);
    КонецЦикла;
    Коды = Новый Структура("codes,orderId", Данные.codes, OrderId);
    Для Каждого Поле Из СтрРазделить("omsId,blockId", ",") Цикл
        ЗначениеПоля = "";
        Если Данные.Свойство(Поле, ЗначениеПоля) Тогда Коды.Вставить(Поле, ЗначениеПоля); КонецЕсли;
    КонецЦикла;
    Паспорт = Новый Структура;
    Паспорт.Вставить("Manufacturer_inn", СокрЛП(Основание.Организация.ИНН));
    Паспорт.Вставить("Batch_date_production", Формат(ДатаПроизводства, "ДФ=yyyy-MM-dd"));
    Паспорт.Вставить("Batch_date_expired", Формат(ГоденДо, "ДФ=yyyy-MM-dd"));
    Паспорт.Вставить("Batch_number", Строка(Серия));
    Задание = Новый Структура("Gtin,Quantity,PasportData,directMode,emissionDocumentId",
        GTIN, Количество, Паспорт, Истина, OrderId);
    Задание.Вставить("Article", Основание.Номенклатура.Артикул);
    Задание.Вставить("source1cEmissionId", Строка(ДокументЭмиссии.УникальныйИдентификатор()));
    Задание.Вставить("source1cAttachmentName", Файлы[0].Имя);
    ИДЗадания = НРег(Строка(ДокументЭмиссии.УникальныйИдентификатор()));
    Если ИДЗадания = OrderId Тогда ВызватьИсключение "Имена задания и кодов совпадают."; КонецЕсли;
    Возврат Новый Структура("OrderId,TaskId,Коды,Задание,Количество,ДатаПроизводства,ГоденДо",
        OrderId, ИДЗадания, ВJSON(Коды), ВJSON(Задание), Количество,
        Паспорт.Batch_date_production, Паспорт.Batch_date_expired);
КонецФункции

Функция РазобратьJSON(Текст)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Значение = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Значение;
КонецФункции

Функция ВJSON(Значение)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции

Процедура Выгрузить(Пакет, Настройки) Экспорт
    Если Настройки.Режим <> "local" И Настройки.Режим <> "aws" И Настройки.Режим <> "function" Тогда
        ВызватьИсключение "Способ выгрузки: local, aws или function.";
    КонецЕсли;
    // Коды публикуются первыми. Задание является разрешением на обработку пары.
    СохранитьФайл(Пакет.OrderId + ".json", Пакет.Коды, Настройки);
    СохранитьФайл(Пакет.TaskId + ".json", Пакет.Задание, Настройки);
КонецПроцедуры

Функция Хеш(Данные)
    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(Данные);
    Возврат Base64Строка(Хеширование.ХешСумма);
КонецФункции

Процедура СохранитьФайл(Имя, Текст, Настройки)
    Данные = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);
    Если Данные.Размер() > 30000000 Тогда ВызватьИсключение "Файл превышает 30 МБ."; КонецЕсли;
    Если Настройки.Режим = "local" Тогда
        // Действующий файловый uploader ограничен 1 МиБ; не создавать неподъёмный для него файл.
        Если Данные.Размер() > 1048576 Тогда ВызватьИсключение "Файл превышает лимит 1 МиБ действующего uploader. Используйте aws/function или обновите его лимит."; КонецЕсли;
        Если ПустаяСтрока(Настройки.Папка) Тогда ВызватьИсключение "Укажите папку обмена на сервере 1С."; КонецЕсли;
        Путь = Настройки.Папка + "/" + Имя;
        ФайлНазначения = Новый Файл(Путь);
        Если ФайлНазначения.Существует() Тогда
            Если Хеш(Новый ДвоичныеДанные(Путь)) <> Хеш(Данные) Тогда ВызватьИсключение "Конфликт: файл уже существует с другим содержимым."; КонецЕсли;
            Возврат;
        КонецЕсли;
        // Публикация завершённого файла одним переименованием в той же папке.
        // System.IO.File.Move не перезаписывает существующее имя при конкурентной выгрузке.
        Временный = Настройки.Папка + "/" + Строка(Новый УникальныйИдентификатор) + ".tmp";
        Данные.Записать(Временный);
        Попытка
            ПереместитьБезЗамены(Временный, Путь);
        Исключение
            УдалитьФайлы(Временный);
            Если Не ФайлНазначения.Существует() Тогда ВызватьИсключение; КонецЕсли;
            Если Хеш(Новый ДвоичныеДанные(Путь)) <> Хеш(Данные) Тогда
                ВызватьИсключение "Конфликт конкурентной записи файла.";
            КонецЕсли;
        КонецПопытки;
    ИначеЕсли Настройки.Режим = "aws" Тогда
        ВызватьИсключение "AWS выполняется только на клиенте через форму обработки.";
    Иначе
        СохранитьЧерезФункцию(Имя, Данные, Настройки);
    КонецЕсли;
КонецПроцедуры

// Base64 передаёт пути как данные: кавычки и спецсимволы пути не становятся кодом.
// Только встроенный Windows PowerShell/.NET; отдельного .ps1 и COM нет.
Процедура ПереместитьБезЗамены(Источник, Назначение)
    Источник64 = СтрЗаменить(СтрЗаменить(Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Источник, КодировкаТекста.UTF8, Ложь)), Символы.ПС, ""), Символы.ВК, "");
    Назначение64 = СтрЗаменить(СтрЗаменить(Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Назначение, КодировкаТекста.UTF8, Ложь)), Символы.ПС, ""), Символы.ВК, "");
    Команда = "$ErrorActionPreference='Stop';[IO.File]::Move([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('"
        + Источник64 + "')),[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('" + Назначение64 + "')))";
    КодВозврата = 0;
    ЗапуститьПриложение("powershell.exe -NoLogo -NoProfile -NonInteractive -Command """ + Команда + """", , Истина, КодВозврата);
    Если КодВозврата <> 0 Тогда ВызватьИсключение "Не удалось опубликовать файл без замены существующего (PowerShell)."; КонецЕсли;
КонецПроцедуры

Функция HTTPS(Адрес, Метод, Данные = Неопределено, ТолькоСоздать = Ложь)
    Если Лев(Адрес, 8) <> "https://" Тогда ВызватьИсключение "Разрешён только HTTPS."; КонецЕсли;
    Остаток = Сред(Адрес, 9);
    Разделитель = СтрНайти(Остаток, "/");
    Если Разделитель = 0 Тогда ВызватьИсключение "В HTTPS-адресе отсутствует путь."; КонецЕсли;
    Сервер = Лев(Остаток, Разделитель - 1);
    Путь = Сред(Остаток, Разделитель);
    Соединение = Новый HTTPСоединение(Сервер, 443, , , , 60, Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос(Путь);
    Если ТолькоСоздать Тогда Запрос.Заголовки.Вставить("If-None-Match", "*"); КонецЕсли;
    Если Данные <> Неопределено Тогда Запрос.УстановитьТелоИзДвоичныхДанных(Данные); КонецЕсли;
    Если Метод = "POST" Тогда Запрос.Заголовки.Вставить("Content-Type", "application/json"); КонецЕсли;
    Возврат Соединение.ВызватьHTTPМетод(Метод, Запрос);
КонецФункции

Процедура СохранитьЧерезФункцию(Имя, Данные, Настройки)
    Если ПустаяСтрока(Настройки.Префикс) Тогда ВызватьИсключение "Укажите общую входящую папку."; КонецЕсли;
    Тело = ВJSON(Новый Структура("file_name,folder", Имя, Настройки.Префикс));
    Ответ = HTTPS(Настройки.АдресФункции, "POST", ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Ложь));
    Если Ответ.КодСостояния <> 200 Тогда ВызватьИсключение "Не получена ссылка для загрузки."; КонецЕсли;
    Ссылки = РазобратьJSON(Ответ.ПолучитьТелоКакСтроку());
    Ответ = HTTPS(Ссылки.upload_url, "PUT", Данные, Истина);
    Если Ответ.КодСостояния = 200 Или Ответ.КодСостояния = 201 Тогда Возврат; КонецЕсли;
    Если Ответ.КодСостояния = 412 Тогда
        Если Не Ссылки.Свойство("download_url") Тогда
            // Действующая bukupl выдаёт GET-ссылку отдельной операцией download.
            Ключ = Настройки.Префикс + ?(Прав(Настройки.Префикс, 1) = "/", "", "/") + Имя;
            ТелоСкачивания = ВJSON(Новый Структура("download", Ключ));
            ОтветСсылки = HTTPS(Настройки.АдресФункции, "POST", ПолучитьДвоичныеДанныеИзСтроки(ТелоСкачивания, КодировкаТекста.UTF8, Ложь));
            Если ОтветСсылки.КодСостояния <> 200 Тогда ВызватьИсключение "Не получена ссылка для проверки существующего файла."; КонецЕсли;
            Ссылки = РазобратьJSON(ОтветСсылки.ПолучитьТелоКакСтроку());
            Если Не Ссылки.Свойство("download_url") Тогда ВызватьИсключение "Функция не вернула download_url для проверки повтора."; КонецЕсли;
        КонецЕсли;
        Прочитано = HTTPS(Ссылки.download_url, "GET");
        Если Прочитано.КодСостояния = 200 Тогда
            Если Хеш(Прочитано.ПолучитьТелоКакДвоичныеДанные()) = Хеш(Данные) Тогда Возврат; КонецЕсли;
            ВызватьИсключение "Конфликт: под этим именем уже существует другое содержимое.";
        КонецЕсли;
    КонецЕсли;
    ВызватьИсключение СтрШаблон("Загрузка не подтверждена (HTTP %1). Для проверки существующего файла функция должна возвращать download_url.", Ответ.КодСостояния);
КонецПроцедуры

// Ключи журнала не содержат кодов маркировки и безопасны для имени файла.
Функция ОтпечатокТекста(Текст) Экспорт
    Значение = Хеш(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь));
    Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(
        Значение, "/", "_"), "+", "-"), "=", ""), Символы.ПС, ""), Символы.ВК, "");
КонецФункции

Функция КлючНазначения(Настройки) Экспорт
    Если Настройки.Режим = "local" Тогда
        Адрес = НРег(СтрЗаменить(Настройки.Папка, "\", "/"));
    ИначеЕсли Настройки.Режим = "aws" Тогда
        Адрес = Настройки.Бакет + "/" + Настройки.Префикс;
    ИначеЕсли Настройки.Режим = "function" Тогда
        Адрес = Настройки.АдресФункции + "|" + Настройки.Префикс;
    Иначе
        ВызватьИсключение "Выберите один из трёх способов выгрузки.";
    КонецЕсли;
    Возврат ОтпечатокТекста(Настройки.Режим + "|" + Адрес);
КонецФункции

Функция ОтпечатокПакета(Пакет, Настройки) Экспорт
    Возврат ОтпечатокТекста(Пакет.Коды + Символы.ПС + Пакет.Задание + Символы.ПС + КлючНазначения(Настройки));
КонецФункции

Процедура ПроверитьПапкуЖурнала(Папка) Экспорт
    Если ПустаяСтрока(Папка) Тогда ВызватьИсключение "Не задана общая папка отметок."; КонецЕсли;
    Каталог = Новый Файл(Папка);
    Если Не Каталог.Существует() Или Не Каталог.ЭтоКаталог() Тогда
        ВызватьИсключение "Общая папка отметок недоступна на сервере 1С.";
    КонецЕсли;
    // Проверить доступ к каталогу, а не трактовать ошибку доступа как отсутствие отметки.
    НайтиФайлы(Папка, "*.receipt", Ложь);
КонецПроцедуры

Функция ПутьОтметки(Папка, ИДДокумента, Настройки)
    Возврат Папка + "/" + ИДДокумента + "-" + КлючНазначения(Настройки) + ".receipt";
КонецФункции

Функция ПрочитатьОтметку(Папка, ИДДокумента, Настройки) Экспорт
    Путь = ПутьОтметки(Папка, ИДДокумента, Настройки);
    ФайлОтметки = Новый Файл(Путь);
    Если Не ФайлОтметки.Существует() Тогда Возврат Неопределено; КонецЕсли;
    Отметка = РазобратьJSON(ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), КодировкаТекста.UTF8));
    Если Не Отметка.Свойство("fingerprint") Или Не Отметка.Свойство("exportedAt") Тогда
        ВызватьИсключение "Повреждена запись журнала выгрузки.";
    КонецЕсли;
    Возврат Отметка;
КонецФункции

Процедура ЗаписатьОтметку(Папка, Пакет, Настройки) Экспорт
    Отпечаток = ОтпечатокПакета(Пакет, Настройки);
    Предыдущая = ПрочитатьОтметку(Папка, Пакет.TaskId, Настройки);
    Если Предыдущая <> Неопределено Тогда
        Если Предыдущая.fingerprint <> Отпечаток Тогда ВызватьИсключение "Отметка относится к другому содержимому файлов."; КонецЕсли;
        Возврат;
    КонецЕсли;
    Отметка = Новый Структура("fingerprint,exportedAt,orderId", Отпечаток,
        Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"), Пакет.OrderId);
    Путь = ПутьОтметки(Папка, Пакет.TaskId, Настройки);
    Временный = Папка + "/" + Строка(Новый УникальныйИдентификатор) + ".tmp";
    ДанныеОтметки = ПолучитьДвоичныеДанныеИзСтроки(ВJSON(Отметка), КодировкаТекста.UTF8, Ложь);
    ДанныеОтметки.Записать(Временный);
    Попытка
        ПереместитьБезЗамены(Временный, Путь);
    Исключение
        УдалитьФайлы(Временный);
        Предыдущая = ПрочитатьОтметку(Папка, Пакет.TaskId, Настройки);
        Если Предыдущая = Неопределено Тогда ВызватьИсключение; КонецЕсли;
        Если Предыдущая.fingerprint <> Отпечаток Тогда ВызватьИсключение "Конфликт общей отметки выгрузки."; КонецЕсли;
    КонецПопытки;
КонецПроцедуры
